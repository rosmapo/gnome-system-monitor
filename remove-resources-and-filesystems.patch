-float
-LoadGraph::translate_to_log_partial_if_needed (float position_partial)
-{
-  if (this->is_logarithmic_scale ())
-    position_partial = position_partial == 0 ? 0 : log10 (position_partial * 100) / 2;
-
-  return position_partial;
