-  g_debug ("disks: start timeout");
-  g_clear_handle_id (&self->timeout, g_source_remove);
-  self->timeout = g_timeout_add (self->update_interval, disks_timeout, self);
-  g_source_set_name_by_id (self->timeout, "refresh disks");
-  disks_update (self);
